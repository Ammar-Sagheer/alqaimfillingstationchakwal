# Copy this file to .env.local and fill in the values from your Supabase project
# dashboard (Project Settings -> API). Never commit .env.local.

# Safe to expose to the browser - RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# SECRET. Bypasses RLS entirely. Server-side only, never prefixed NEXT_PUBLIC_.
# Used only for creating and managing staff logins, since that needs the Admin
# API. If this leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
